# Neon Postgres (server-side only)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Magic link auth (server-side only)
RESEND_API_KEY=re_xxxxxxxxxxxx
SESSION_SECRET=generate-with-openssl-rand-hex-32
# Canonical origin used to build magic-link URLs. Optional locally (falls back to
# the request origin); required on the server. Prod sets NUXT_SITE_URL instead.
SITE_URL=http://localhost:3000

# Activity ingest (server-side only)
# Slack app "Signing Secret" (Basic Information): verifies /api/ingest/slack
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Shared bearer token for agent-driven /api/ingest/event (Luma etc.); openssl rand -hex 32
INGEST_API_KEY=generate-with-openssl-rand-hex-32

# Investor updates object storage (server-side only)
# GCS bucket with raw update emails + attachments. Read via ADC (gcloud auth
# application-default login locally; the Cloud Run SA in prod). Leave empty to
# disable attachment serving locally.
GCS_INVESTOR_UPDATES_BUCKET=cto-roundtable-investor-updates

# Styreprotokoller object storage (server-side only)
# GCS bucket the portal WRITES issued protocol PDFs to and reads them back from.
# Same ADC model as above. Leave empty locally unless you have gcloud ADC and
# write access; issuing a protocol fails with 503 rather than half-succeeding.
GCS_BOARD_PROTOCOLS_BUCKET=cto-roundtable-board-protocols

# PostHog analytics (client-side, safe to expose)
POSTHOG_TOKEN=your_token_here
POSTHOG_HOST=https://eu.i.posthog.com
